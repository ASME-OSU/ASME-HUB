/* Add to the SAME private standalone copy/setup/settings project.
 * Deploy only as USER_ACCESSING. No public POST writer or client OAuth token. */
function doGet() {
  annualSettingsWebContext_();
  return HtmlService.createHtmlOutputFromFile('AnnualSettingsPage').setTitle('ASME annual settings');
}
function annualSettingsWebContext_() {
  ScriptApp.requireAllScopes(ScriptApp.AuthMode.FULL);
  var props = PropertiesService.getScriptProperties();
  function config(key) {
    var value = props.getProperty(key);
    if (!value) throw new Error('Annual save is not configured. Contact the chapter setup officer.');
    return JSON.parse(value);
  }
  var manualText=props.getProperty('ANNUAL_MANUAL_SETTINGS_CONFIG');
  var manual=manualText?readAnnualManualRules_(JSON.parse(manualText)):null;
  var copy = manual?{intendedOwner:manual.intendedOwner}:config('ANNUAL_COPY_CONFIG');
  var setup = manual?null:config('ANNUAL_SETUP_CONFIG');
  var draft = manual?manual.draft:config('ANNUAL_SETTINGS_DRAFT_CONFIG');
  if (!draft || manual && (manual.year!==draft.year || draft.ledgerId===manual.annualRootId || manual.excludedSourceIds.indexOf(draft.ledgerId)>=0)) throw new Error('Private manual draft target configuration is incomplete.');
  var active = String(Session.getActiveUser().getEmail()).trim().toLowerCase();
  var effective = String(Session.getEffectiveUser().getEmail()).trim().toLowerCase();
  var intended = String(copy.intendedOwner || '').trim().toLowerCase();
  if (!active || active !== effective || effective !== intended) throw new Error('Sign in as the configured chapter account. This page must run as the user accessing it.');
  return {props:props,copy:copy,setup:setup,draft:draft,actor:active,manual:manual};
}
function previewAnnualSettingsWeb(inputText) {
  var ctx = annualSettingsWebContext_();
  // Each browser keeps its own exact ticket. A new tab cannot replace another tab's review.
  // Legacy single-slot tickets are never used to authorize a write.
  var user = PropertiesService.getUserProperties();
  user.deleteProperty('ANNUAL_WEB_PREVIEW');
  if (typeof inputText !== 'string' || inputText.length > 16000) throw new Error('Choose a Hub Google save file under 16 KB.');
  var input = JSON.parse(inputText);
  if (!input || input.schema !== 1 || input.type !== 'asme-annual-settings-input' || !input.handoff || input.handoff.year !== ctx.draft.year || !input.values || Object.keys(input).sort().join(',') !== 'handoff,schema,type,values') throw new Error('The Hub save file does not match the privately configured annual year.');
  // Only public row selections are imported. Google resource identities, ledger,
  // Control Center, year and fixed timestamp always come from private configuration.
  if (Object.keys(input.values).sort().join(',') !== Object.keys(ctx.draft.values).sort().join(',')) throw new Error('Explicit selections for every public settings field are required.');
  // Preserve the existing private config's field order for immutable journal repeat.
  var values = {};
  Object.keys(ctx.draft.values).forEach(function(key){values[key]=input.values[key];});
  var draft = Object.assign({}, ctx.draft, {values:values});
  var io,preview;
  if (ctx.manual) {
    var manual=Object.assign({},ctx.manual,{handoff:input.handoff,draft:draft});
    var verifier=manualAnnualVerificationIO_(manual);
    preview=verifier.lock(function(){
      var verified=ManualAnnualVerificationEngine.verify(input.handoff,manual,verifier);
      draft.manualVerificationDigest=verified.digest;
      io=manualAnnualDraftIO_(manual,ctx.props,verified.digest,draft);
      io.lock=function(fn){return fn();};
      // This canonical result was just observed under this same preview lock.
      // Save uses the normal adapter to independently verify the digest again.
      io.verifiedHandoff=function(){return verified.handoff;};
      return AnnualSettingsDraftEngine.run(input.handoff,draft,io,null);
    });
  } else {
    io = annualSettingsDraftIO_(ctx.copy,ctx.setup,draft,ctx.props);
    preview = AnnualSettingsDraftEngine.run(input.handoff,draft,io,null);
  }
  var ticket = Utilities.getUuid(), createdAt = Date.now();
  var prepared = JSON.stringify({actor:ctx.actor,ticket:ticket,createdAt:createdAt,handoff:input.handoff,draft:draft,digest:preview.digest,manual:!!ctx.manual});
  if (Utilities.newBlob(prepared).getBytes().length > 8500) throw new Error('The reviewed settings are too large. Shorten the public notes and URLs.');
  storeAnnualWebTicket_('settings',ticket,prepared);
  return {ticket:ticket,preview:preview,draftTimestamp:draft.draftTimestamp,verifiedAt:new Date(createdAt).toISOString(),expiresAt:new Date(createdAt+30*60*1000).toISOString()};
}
function saveAnnualSettingsWeb(ticket, publicLinkReview, reviewNote) {
  var ctx = annualSettingsWebContext_();
  var prepared = readAnnualWebTicket_('settings',ticket,ctx.actor);
  if (publicLinkReview !== true || typeof reviewNote !== 'string' || !reviewNote.trim() || reviewNote.length > 1000) throw new Error('Review the public row and record a short audience review before saving.');
  // An administrator's configuration changes invalidate the reviewed preview.
  var expected = Object.assign({},ctx.draft,{values:prepared.draft.values});
  if (ctx.manual) expected.manualVerificationDigest=prepared.draft.manualVerificationDigest;
  if (!!ctx.manual!==prepared.manual) throw new Error('Annual save mode changed. Verify the file again.');
  if (JSON.stringify(expected) !== JSON.stringify(prepared.draft)) throw new Error('Private annual configuration changed. Import and verify again.');
  var io = ctx.manual?manualAnnualDraftIO_(Object.assign({},ctx.manual,{handoff:prepared.handoff,draft:prepared.draft}),ctx.props,prepared.draft.manualVerificationDigest,prepared.draft):annualSettingsDraftIO_(ctx.copy,ctx.setup,prepared.draft,ctx.props);
  return AnnualSettingsDraftEngine.run(prepared.handoff,prepared.draft,io,{year:prepared.draft.year,digest:prepared.digest,publicLinkReview:true,reviewNote:reviewNote.trim()});
}


// Five independent reviews per actor/kind, 30-minute TTL, 8.5 KB per property.
// The user lock only guards ticket storage; engine writes use their project lock.
function storeAnnualWebTicket_(kind,ticket,prepared) {
  if (Utilities.newBlob(prepared).getBytes().length>8500) throw new Error('The reviewed ticket exceeds 8.5 KB. Shorten public notes and URLs.');
  var lock=LockService.getUserLock();lock.waitLock(30000);
  try {
    var user=PropertiesService.getUserProperties(),prefix='ANNUAL_WEB_'+kind+'_',now=Date.now();
    var all=user.getProperties(),entries=[];
    Object.keys(all).filter(function(key){return key.indexOf(prefix)===0;}).forEach(function(key){
      var value;try{value=JSON.parse(all[key]);}catch(error){user.deleteProperty(key);return;}
      if (!Number.isFinite(value.createdAt) || now-value.createdAt<0 || now-value.createdAt>30*60*1000) user.deleteProperty(key);
      else entries.push({key:key,createdAt:value.createdAt});
    });
    entries.sort(function(a,b){return a.createdAt-b.createdAt || a.key.localeCompare(b.key);});
    while(entries.length>=5) user.deleteProperty(entries.shift().key);
    user.setProperty(prefix+ticket,prepared);
  } finally {lock.releaseLock();}
}
function readAnnualWebTicket_(kind,ticket,actor) {
  if (typeof ticket!=='string' || !/^[A-Za-z0-9_-]{1,100}$/.test(ticket)) throw new Error('Import and verify the file first. Verification ticket is missing or changed.');
  var raw=PropertiesService.getUserProperties().getProperty('ANNUAL_WEB_'+kind+'_'+ticket);
  if (!raw) throw new Error('This verification ticket expired or was replaced after five newer reviews. Import and verify the same file again first.');
  var value=JSON.parse(raw),age=Date.now()-value.createdAt;
  if (value.ticket!==ticket || value.actor!==actor) throw new Error('Verification account or ticket changed. Use the configured chapter account and verify again.');
  if (!Number.isFinite(value.createdAt) || age<0 || age>30*60*1000) throw new Error('This verification expired after 30 minutes. Import and verify the same file again.');
  return value;
}

// Formula inventories can exceed the 9 KB Script Property value limit.
// Only a private, chapter-owned JSON file named by private properties is read.
function readAnnualManualRules_(reference) {
  if (!reference || reference.schema !== 1 || !/^[A-Za-z0-9_-]{20,200}$/.test(reference.rulesFileId) || !reference.intendedOwner) throw new Error('Private manual rules file reference required.');
  var owner=String(reference.intendedOwner).trim().toLowerCase();
  var active=String(Session.getActiveUser().getEmail()).trim().toLowerCase();
  if (!active || active!==owner || String(Session.getEffectiveUser().getEmail()).trim().toLowerCase()!==owner) throw new Error('Sign in as the configured chapter account.');
  var metadata=annualCopyIO_({}).metadata(reference.rulesFileId);
  if (!metadata || metadata.trashed || metadata.driveId || metadata.mimeType!=='application/json' || !metadata.owners || metadata.owners.length!==1 || String(metadata.owners[0].emailAddress).trim().toLowerCase()!==owner || !metadata.capabilities || !metadata.capabilities.canEdit || !Array.isArray(metadata.permissions) || !metadata.permissions.length || metadata.permissions.some(function(p){return p.type!=='user'||!p.emailAddress;})) throw new Error('Private chapter-owned manual rules file required.');
  var file=DriveApp.getFileById(reference.rulesFileId);
  if (file.getSize()>250000) throw new Error('Manual rules exceed the reviewed 250 KB bound.');
  var rules=JSON.parse(file.getBlob().getDataAsString('UTF-8'));
  if (String(rules.intendedOwner).trim().toLowerCase()!==owner || rules.draft && [rules.draft.ledgerId,rules.draft.controlCenterId,rules.annualRootId].indexOf(reference.rulesFileId)>=0 || rules.excludedSourceIds && rules.excludedSourceIds.indexOf(reference.rulesFileId)>=0) throw new Error('Manual rules owner/target identity conflict.');
  return Object.assign({},rules,{rulesFileId:reference.rulesFileId});
}

// Officer action for a separately reviewed copy-journal run. Manual rules never
// become a fabricated copy ledger: a maintainer must provision the fresh run.
function annualSetupWebContext_() {
  var ctx=annualSettingsWebContext_(),rawCopy=ctx.props.getProperty('ANNUAL_COPY_CONFIG'),rawSetup=ctx.props.getProperty('ANNUAL_SETUP_CONFIG');
  if (!rawCopy || !rawSetup) throw new Error('Fresh-copy setup needs a reviewed maintainer handoff. Contact the outgoing President/transition coordinator at asme@osu.edu to provision the private copy/setup run and return its completion receipt.');
  var copy=JSON.parse(rawCopy),setup=JSON.parse(rawSetup);
  if (String(copy.intendedOwner).trim().toLowerCase()!==ctx.actor || copy.year!==ctx.draft.year || setup.year!==ctx.draft.year) throw new Error('The private setup run belongs to a different account/year. Contact the transition coordinator at asme@osu.edu to prepare this year; preserve the existing journal.');
  return {copy:copy,setup:setup,actor:ctx.actor,io:annualSetupIO_(copy,setup)};
}
function previewAnnualSetupWeb(phase) {
  if (phase!=='destination' && phase!=='workbooks') throw new Error('Choose destination or workbooks setup.');
  var ctx=annualSetupWebContext_(),preview=AnnualSetupEngine.run(ctx.copy,ctx.setup,ctx.io,phase,null),ticket=Utilities.getUuid(),now=Date.now();
  var prepared=JSON.stringify({ticket:ticket,actor:ctx.actor,createdAt:now,phase:phase,year:ctx.copy.year,digest:preview.digest,configDigest:ctx.io.digest(JSON.stringify({copy:ctx.copy,setup:ctx.setup}))});
  storeAnnualWebTicket_('setup',ticket,prepared);
  return {ticket:ticket,preview:preview,verifiedAt:new Date(now).toISOString(),expiresAt:new Date(now+30*60*1000).toISOString()};
}
function configureAnnualSetupWeb(ticket,reviewed) {
  var ctx=annualSetupWebContext_(),prepared=readAnnualWebTicket_('setup',ticket,ctx.actor);
  if (reviewed!==true) throw new Error('Review the exact setup changes before configuring.');
  if (prepared.configDigest!==ctx.io.digest(JSON.stringify({copy:ctx.copy,setup:ctx.setup}))) throw new Error('Private setup configuration changed. Preview setup again.');
  var result=AnnualSetupEngine.run(ctx.copy,ctx.setup,ctx.io,prepared.phase,{year:prepared.year,phase:prepared.phase,digest:prepared.digest});
  if(prepared.phase==='workbooks')result.handoff=AnnualSetupEngine.handoff(ctx.copy,ctx.setup,ctx.io);
  return result;
}
