/**
 * DISABLED legacy writer example. Do not deploy.
 *
 * The previous public-token GET writer did not authorize Google officers.
 * Shared edits now use Google-authorized direct Sheet editing. Removing this
 * source does not revoke any existing deployment: an authorized owner must
 * inspect and retire it separately. See SETTINGS_WRITE_CONTRACT.md.
 */
function doGet() {
  return ContentService.createTextOutput(JSON.stringify({
    ok: false,
    error: "Hub writes are disabled. Edit the settings Sheet with Google authorization."
  })).setMimeType(ContentService.MimeType.JSON);
}
function doPost() {
  return doGet();
}
